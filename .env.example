# Copy to .env.local and fill in. The app shows a setup screen until the Firebase web keys are set.

# Firebase web app (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK, server only (Project settings → Service accounts → Generate new private key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes; newlines as \n
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Bachs payments, server only (see lib/bachs.ts and https://docs.bachs.io)
# Sandbox: https://sandbox-api.bachs.io with an sk_sandbox_ key. Live: https://api.bachs.io with an sk_live_ key.
BACHS_API_URL=https://sandbox-api.bachs.io
# Needs these permissions: checkout, payouts:read, payouts:write (bank details page), balance:read
BACHS_SECRET_KEY=
# Signing secret of your webhook endpoint (Developer Portal → Webhooks → your endpoint)
BACHS_WEBHOOK_SECRET=

# Public address of the site, e.g. https://keepr.ng. Used for link preview images (WhatsApp, X, Slack…)
# and Bachs return URLs (Bachs refuses localhost). On Vercel it falls back to the deployment URL.
APP_URL=https://your-domain.com
