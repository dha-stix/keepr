rules_version = '2';
// Keepr Storage rules. Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Room photos: anyone can view; only admin managers upload or delete. Images only, under 5 MB (the app sends ~300 KB).
    match /rooms/{category}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && category in ['standard', 'exclusive', 'presidential']
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
